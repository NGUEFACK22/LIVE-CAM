# ============================================================
# ChapCam — variables d'environnement (exemple)
# Copier vers .env.local et remplir les valeurs.
# Aucune valeur de production n'est codée en dur dans le code :
# sans ces variables, l'app refuse de démarrer (erreur explicite).
# ============================================================

# ------------------------------------------------------------
# Mode gratuit
# ------------------------------------------------------------
# Le Live Swap / Face Swap est GRATUIT et ILLIMITÉ quand ce flag est vrai.
# EN PRODUCTION : mettez EXPRESSÉMENT false pour réactiver les forfaits
# payants et la déduction de points. Si la variable est absente, le défaut
# reste true (gratuit) avec un avertissement dans les logs.
NEXT_PUBLIC_FREE_LIVE_SWAP=true

# ------------------------------------------------------------
# Supabase (OBLIGATOIRE — serveur + navigateur)
# ------------------------------------------------------------
# URL du projet (ex: https://xxx.supabase.co) — tableau de bord Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon (publique, inlinée côté navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role (SECRÈTE — uniquement côté serveur, jamais exposée)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Decart AI (OBLIGATOIRE pour le Live Swap cloud Lucy)
# https://platform.decart.ai
# ------------------------------------------------------------
# IMPORTANT (depuis v1.0.11) : les routes /api/decart-token et
# /api/decart-session lisent d'abord la table Supabase `app_config`
# (fonction RPC get_app_config), puis retombent sur cette variable
# d'environnement. Cela permet de changer la cle pour TOUS les clients
# (web + desktop deja installes) SANS rebuild — execute juste le SQL
# `supabase/supabase-app-config.sql` dans le dashboard Supabase.
DECART_API_KEY=
# Optionnel : clé sans watermark (rendu propre pour les forfaits éligibles)
DECART_API_KEY_NO_WATERMARK=

# ------------------------------------------------------------
# Live GPU — second moteur face-swap (worker WebSocket / RunPod)
# ------------------------------------------------------------
# Secret partagé pour signer les tokens HMAC du worker GPU (obligatoire si GPU live)
LIVE_GPU_SHARED_SECRET=
# URL(s) WebSocket du worker (séparées par des virgules pour le multi-worker)
# LIVE_GPU_WS_URL=
# LIVE_GPU_WS_URLS=
# Pod(s) RunPod (séparés par des virgules)
# RUNPOD_POD_ID=
# RUNPOD_POD_IDS=
# Pool "trial" (moteur PersonaLive, essai gratuit) — optionnel
# LIVE_GPU_TRIAL_WS_URL=
# RUNPOD_TRIAL_POD_ID=

# ------------------------------------------------------------
# RunPod — face swap serverless / cloud swap
# ------------------------------------------------------------
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=            # endpoint /run, /runsync, /status
# RUNPOD_ENDPOINT_FACE=          # endpoint utilisé par le cloud swap (use-cloud-swap)
# RUNPOD_SERVERLESS_ID=

# ------------------------------------------------------------
# LiveKit — cloud swap temps réel (optionnel)
# ------------------------------------------------------------
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=wss://chapcam.livekit.cloud

# ------------------------------------------------------------
# fal.ai — face swap photo (optionnel, route /api/swap)
# ------------------------------------------------------------
# FAL_KEY=

# ------------------------------------------------------------
# Paiements
# ------------------------------------------------------------
# PayDunya
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_TOKEN=
# PAYDUNYA_MODE=test
# Trybit (crypto)
# TRYBIT_API_KEY=
# TRYBIT_SHOP_ID=
# TRYBIT_SECRET=
# Mode strict : exige la signature JWT sur chaque postback Trybit
# TRYBIT_REQUIRE_SIGNATURE=false
# NOWPayments
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# ------------------------------------------------------------
# Divers
# ------------------------------------------------------------
# Email transactionnel (Resend)
# RESEND_API_KEY=
# Secret des webhooks internes / Supabase
# SUPABASE_WEBHOOK_SECRET=
# INTERNAL_API_SECRET=
# Cloudflare Turnstile (anti-bot inscription)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Admin ChapCam (défaut: fanny.guck@gmail.com — voir lib/admin-email.ts)
# ADMIN_EMAIL=
